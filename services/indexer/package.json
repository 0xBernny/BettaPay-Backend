{
  "name": "indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm src/cleanup.test.ts"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "@bettapay/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tape": "^5.6.4",
    "tape": "^5.9.0",
    "typescript": "^5.3.3"
  }
}
