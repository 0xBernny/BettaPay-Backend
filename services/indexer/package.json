{
  "name": "indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm --filter @bettapay/validation build && cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm src/index.test.ts && cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm src/webhook-test.test.ts"
  },
  "dependencies": {
    "@bettapay/validation": "workspace:*",
    "@prisma/client": "*",
    "@stellar/stellar-sdk": "*",
    "bullmq": "*",
    "fastify": "*",
    "@fastify/cors": "*",
    "@fastify/helmet": "*",
    "ioredis": "*",
    "zod": "^3.22.4",
    "@fastify/rate-limit": "~11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tape": "^5.6.4",
    "cross-env": "^7.0.3",
    "tape": "^5.9.0",
    "typescript": "^5.3.3",
    "@types/pg": "^8.20.0"
  }
}
