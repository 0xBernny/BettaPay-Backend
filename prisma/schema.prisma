datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentStatus {
  initiated
  completed
  failed
  cancelled
}

enum SettlementStatus {
  pending
  processing
  completed
  failed
}

model Merchant {
  id          String       @id
  name        String
  ownerId     String
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  settings    Json?
  secretHash  String?
  payments    Payment[]
  settlements Settlement[]

  @@unique([ownerId])
}

model Payment {
  id                      String        @id
  merchantId              String
  merchant                Merchant      @relation(fields: [merchantId], references: [id])
  payerId                 String?
  amount                  Decimal       @db.Decimal(18, 6)
  asset                   String
  status                  PaymentStatus @default(initiated)
  reference               String?
  createdAt               DateTime      @default(now())
  // Idempotency support: optional client-supplied key with 24-hour TTL.
  // The @unique constraint is the database-level race guard that prevents
  // duplicate creation even under concurrent requests.
  idempotencyKey          String?       @unique
  idempotencyKeyExpiresAt DateTime?
  // FX conversion metadata (populated when convertTo is supplied at creation)
  convertTo              String?
  convertedAmount         String?
  fxRate                  String?
  fxQuoteId               String?
  fxQuoteExpiresAt        DateTime?
}

model Settlement {
  id                      String           @id
  merchantId              String
  merchant                Merchant         @relation(fields: [merchantId], references: [id])
  totalAmount             String
  grossAmount             String
  feeAmount               String
  netAmount               String
  feeBps                  Int
  asset                   String
  status                  SettlementStatus @default(pending)
  webhookUrl              String?
  batchId                 String?
  initiatedAt             DateTime         @default(now())
  completedAt             DateTime?
  // Atomic idempotency guard: unique constraint prevents duplicate settlements
  // under concurrent requests even if Redis SET NX is unavailable (#240).
  idempotencyKey          String?          @unique
  idempotencyKeyExpiresAt DateTime?
  // Fee audit snapshot — records the exact fee parameters used at settlement
  // time for forensic analysis of historical fees (#330).
  feeSnapshot             Json?

  @@index([initiatedAt(sort: Desc)])
  @@index([merchantId, initiatedAt(sort: Desc)])
}

model IndexedEvent {
  id             String   @id
  stellarId      String?
  contractId     String
  contractName   String?
  topics         String[]
  type           String
  rawValue       String
  decodedPayload Json?
  ledger         Int
  indexedAt      DateTime @default(now())

  @@unique([stellarId, contractId, ledger])
  @@index([ledger])
  @@index([type])
  @@index([contractId])
  @@index([indexedAt])
}

model WebhookSubscription {
  id            String   @id
  url           String
  createdAt     DateTime @default(now())
  signingSecret String?
  merchantId    String?
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  actorType  String?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@index([entityId])
}

model SupportedAsset {
  code       String  @id
  contractId String
  decimals   Int
  name       String
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SettlementBatch {
  id         String   @id @default(cuid())
  asset      String
  totalCount Int
  totalGross String
  totalFees  String
  totalNet   String
  createdAt  DateTime @default(now())
  processedAt DateTime?
}
